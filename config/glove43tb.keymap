#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        macro_mac: macro_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &out OUT_BLE &bt BT_SEL 0>;
        };

        macro_win: macro_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &out OUT_BLE &bt BT_SEL 1>;
        };

        macro_gemini: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(L) &kp H &kp T &kp T &kp P &kp S &kp COLON &kp FSLH &kp FSLH &kp G &kp E &kp M &kp I &kp N &kp I &kp DOT &kp G &kp O &kp O &kp G &kp L &kp E &kp DOT &kp C &kp O &kp M &kp FSLH &kp A &kp P &kp P &kp QMARK &kp H &kp L &kp EQUAL &kp J &kp A &kp ENTER>;
            label = "NEW_MACRO";
        };

        macro_NotebookLM: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(L) &kp H &kp T &kp T &kp P &kp S &kp COLON &kp FSLH &kp FSLH &kp N &kp O &kp T &kp E &kp B &kp O &kp O &kp K &kp L &kp M &kp DOT &kp G &kp O &kp O &kp G &kp L &kp E &kp DOT &kp C &kp O &kp M &kp FSLH &kp ENTER>;
            label = "NEW_MACRO";
        };
    };

    behaviors {
        sensor_rotate_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_wheel_scroll: mouse_wheel_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        My_Mac {
            bindings = <
&mt TAB Q         &kp W             &kp E         &kp R        &kp T                                                  &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A             &kp S             &kp D         &kp F        &kp G             &kp LS(LG(S))         &kp MINUS      &kp H        &kp J  &kp K      &kp L    &kp ENTER
&mt LEFT_SHIFT Z  &kp X             &kp C         &kp V        &kp B             &kp COLON             &kp SEMICOLON  &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_SHIFT    &kp LEFT_CONTROL  &kp LEFT_ALT  &lt 6 LANG2  &kp LEFT_COMMAND  &lt 2 LANGUAGE_1      &kp BACKSPACE  &lt 3 SPACE                             &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp LA(LG(LC(RIGHT))) LA(LC(LG(LEFT)))>;
        };

        My_Windows {
            bindings = <
&mt TAB Q         &kp W             &kp E         &kp R               &kp T                                                  &kp Y        &kp U  &kt I      &kp O    &kp P
&kp A             &kp S             &kp D         &kp F               &kp G             &kp LS(LG(S))         &kp MINUS      &kp H        &kp J  &kp K      &kp L    &kp ENTER
&mt LEFT_SHIFT Z  &kp X             &kp C         &kp V               &kp B             &kp COLON             &kp SEMICOLON  &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_SHIFT    &kp LEFT_CONTROL  &kp LEFT_ALT  &lt 6 INT_MUHENKAN  &kp LEFT_CONTROL  &lt 2 INT_HENKAN      &kp BACKSPACE  &lt 8 SPACE                             &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp LG(LS(RIGHT)) LG(LS(LEFT))>;
        };

        NUM_SYM {
            bindings = <
&kp EXCL   &kp AT     &kp HASH       &kp DLLR  &kp PRCNT                              &kp KP_PLUS  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MULTIPLY
&kp CARET  &kp AMPS   &kp ASTRK      &kp LPAR  &kp RPAR   &trans        &kp KP_EQUAL  &kp KP_N0    &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_DIVIDE
&kp TILDE  &kp GRAVE  &kp LBKT       &kp RBKT  &kp BSLH   &kp PIPE      &trans        &kp KP_DOT   &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_MINUS
&trans     &kp COLON  &kp SEMICOLON  &trans    &trans     &trans        &trans        &trans                                        &trans
            >;
        };

        Mac_ARROW {
            bindings = <
&kp ESCAPE  &trans           &kp LS(LG(T))  &trans       &trans                         &trans    &kp LC(LEFT)  &kp UP            &kp LC(RIGHT)  &kp PG_UP
&trans      &kp LC(LS(TAB))  &kp LG(T)      &kp LC(TAB)  &kp LG(R)  &trans      &trans  &kp HOME  &kp LEFT      &kp LC(UP_ARROW)  &kp RIGHT      &kp PG_DN
&kp LSHFT   &trans           &kp LG(W)      &trans       &trans     &trans      &trans  &kp END   &trans        &kp DOWN_ARROW    &trans         &trans
&trans      &trans           &trans         &trans       &trans     &trans      &trans  &trans                                                   &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &mo 5       &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SYSTEM {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &macro_mac  &macro_win  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&to 0   &to 1   &to 2   &to 3   &to 9   &trans      &trans       &trans      &trans      &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bootloader  &trans      &trans      &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans                                              &bt BT_CLR_ALL
            >;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&trans  &trans  &trans  &trans  &trans  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans                          &kp F12
            >;

            sensor-bindings = <&sensor_rotate_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        Windows_ARROW {
            bindings = <
&kp ESCAPE  &trans           &kp LC(LS(T))  &trans       &trans                         &trans    &kp LC(LG(LEFT))  &kp UP          &kp LC(LG(RIGHT))  &kp PG_UP
&trans      &kp LC(LS(TAB))  &kp LC(T)      &kp LC(TAB)  &kp LC(R)  &trans      &trans  &kp HOME  &kp LEFT          &kp LG(TAB)     &kp RIGHT          &kp PG_DN
&kp LSHFT   &trans           &kp LC(W)      &trans       &trans     &trans      &trans  &kp END   &kp LC(LS(TAB))   &kp DOWN_ARROW  &kp LC(TAB)        &trans
&trans      &trans           &trans         &trans       &trans     &trans      &trans  &trans                                                         &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(LS(RIGHT)) LG(LS(LEFT))>;
        };

        Work_Windows {
            bindings = <
&mt TAB Q         &kp W             &kp E         &kp R               &kp T                                                  &kp Y        &kp U  &kt I      &kp O    &kp P
&kp A             &kp S             &kp D         &kp F               &kp G             &kp LS(LG(S))         &kp MINUS      &kp H        &kp J  &kp K      &kp L    &kp ENTER
&mt LEFT_SHIFT Z  &kp X             &kp C         &kp V               &kp B             &macro_gemini         &kp SEMICOLON  &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_SHIFT    &kp LEFT_CONTROL  &kp LEFT_ALT  &lt 6 INT_MUHENKAN  &kp LEFT_CONTROL  &lt 2 INT_HENKAN      &kp BACKSPACE  &lt 8 SPACE                             &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp LG(LS(RIGHT)) LG(LS(LEFT))>;
        };
    };
};
